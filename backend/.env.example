# Copy this file to ".env" in the same folder (backend/.env) and fill in your own keys.
# The .env file is git-ignored, so your keys are never uploaded.
# Leave a value empty to run in offline mode (approximate results).

# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, raises the GitHub search rate limit: https://github.com/settings/tokens (no scopes needed)
GITHUB_TOKEN=
